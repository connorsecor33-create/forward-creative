# Public URL of the deployed site (used for canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://forwardtheory.co

# Where project inquiries are delivered. Until this is set, the contact form
# tells visitors it isn't connected yet and offers the email address instead —
# it never pretends a message was sent.
#
# Any endpoint that accepts a JSON POST works: a Formspree form URL,
# a Zapier / Make webhook, a Slack incoming webhook relay, your own API, etc.
CONTACT_WEBHOOK_URL=
